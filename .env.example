PORT=3000
BASE_URL=https://magenta-lobster-733311.hostingersite.com

# Apify webhook security (optional)
WEBHOOK_SECRET=your-random-secret

# Apify — /checkin 启用 Schedule，/checkout 暂停 Schedule
APIFY_TOKEN=
APIFY_SCHEDULE_ID=kHSD3MlxrX02kpJyk

# Telegram — @MyAutoUpwork_bot；Chat ID 可留空，向 Bot 发 /start 会自动绑定
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM: deepseek | openai | gemini
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Minimum AI score to push (1-10)
MIN_SCORE_TO_NOTIFY=8

# Hard filter thresholds
FILTER_MIN_CLIENT_RATING=4.5
FILTER_MIN_CLIENT_SPENT=10000
FILTER_MAX_PROPOSALS=14

# System prompt override (optional, use \n for newlines)
# LLM_SYSTEM_PROMPT=
